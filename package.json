{
  "name": "nodshell",
  "version": "0.1.4",
  "private": true,
  "description": "Visual cockpit for coding agents running in real terminals",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "postinstall": "install-electron",
    "dist": "electron-vite build && electron-builder --linux AppImage deb --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.1",
    "better-sqlite3": "13.1.1",
    "node-pty": "1.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "author": "Felipe",
  "license": "MIT",
  "homepage": "https://github.com/felipedelyra-arch/nodshell",
  "build": {
    "appId": "dev.nodshell.app",
    "productName": "NodShell",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Felipe",
      "artifactName": "nodshell-${version}-${arch}.${ext}",
      "executableName": "nodshell",
      "syncDesktopName": true
    },
    "npmRebuild": true
  },
  "desktopName": "nodshell.desktop"
}
